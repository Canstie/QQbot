# NoneBot server. Reverse WebSocket mode is recommended:
# configure LLOneBot/NapCat ws_reverse_url to ws://127.0.0.1:8080/onebot/v11/ws
DRIVER=~fastapi
HOST=127.0.0.1
PORT=8080

# Forward WebSocket mode is also supported when the OneBot implementation exposes a WS server:
# DRIVER=~fastapi+~websockets
# ONEBOT_WS_URLS=["ws://127.0.0.1:3001"]

# Must match the access token configured in LLOneBot/NapCat.
ONEBOT_ACCESS_TOKEN=change-this-token

# Bootstrap bot admins. Use QQ numbers, comma-separated.
QQBOT_ADMINS=10000

# SQLite and policy defaults.
QQBOT_DB_PATH=data/qqbot.sqlite3
QQBOT_POLICY_MODE=allowlist
QQBOT_TRIGGER_MENTION=true
QQBOT_TRIGGER_PREFIXES=~,#bot
QQBOT_PER_GROUP_SECONDS=5
QQBOT_PER_USER_PER_MINUTE=5

# Optional Lua scripting. Command scripts use scripts/lua/<command>.lua.
QQBOT_LUA_ENABLED=true
QQBOT_LUA_DIR=scripts/lua
QQBOT_LUA_SCRIPT=scripts/main.lua
QQBOT_LUA_TIMEOUT_SECONDS=10

# Optional domestic menu API source for ~今日菜单.
# auto: use JisuAPI when QQBOT_JISU_RECIPE_APPKEY is set, otherwise use local recipes.
# local: only use local recipes. jisu: prefer 极速数据/JisuAPI, then fall back locally.
QQBOT_MENU_PROVIDER=auto
QQBOT_JISU_RECIPE_APPKEY=

# Optional token for the local web admin API/page at /qqbot.
# If set, pass it as X-Admin-Token or ?token=...
QQBOT_WEB_TOKEN=change-this-web-token

